# Copier ce fichier en .env (jamais commité) : cp .env.example .env
# Identifiants de développement uniquement, alignés sur docker-compose.yml
DATABASE_URL="postgresql://levelup:levelup_dev@localhost:5432/levelupjv?schema=public"

# Secret de signature des jetons de connexion (à changer en production)
JWT_SECRET="levelupjv-dev-secret-a-changer"
PORT=3001

# Tuteur IA (facultatif). Sans clé, le tuteur donne un conseil construit sans IA.
# Gemini (palier gratuit) : clé à créer sur https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Identifiant du modèle : voir la liste avec
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models | grep '"name"'
# GEMINI_MODEL=gemini-3.5-flash-lite
# Claude (payant), à la place de Gemini :
# ANTHROPIC_API_KEY=sk-ant-...
# Forcer un fournisseur : gemini | claude | none (par défaut : le premier dont la clé est présente)
# TUTOR_PROVIDER=gemini
